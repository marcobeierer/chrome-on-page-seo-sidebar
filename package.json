{
  "name": "on-page-seo-sidebar",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome side panel extension for on-page SEO, structured data, and Google Search Console query data.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:store": "npm run build && node scripts/package-store.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.mjs",
    "coverage": "npm run build && node scripts/coverage.mjs",
    "test:e2e": "npm run build && node --test tests/e2e/**/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.28.0",
    "linkedom": "^0.18.12",
    "typescript": "^5.5.4"
  }
}
